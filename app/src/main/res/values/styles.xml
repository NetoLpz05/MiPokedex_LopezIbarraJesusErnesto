<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pokedex.Base"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!--Nombre-->
    <style name="Pokedex.Title"
        parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!--Número-->
    <style name="Pokedex.Number"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/black</item>
        <item name="android:alpha">0.85</item>
    </style>

    <!--Titulos de sección-->
    <style name="Pokedex.Section"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <!-- Este color se puede cambiar dinámicamente -->
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--Labels-->
    <style name="Pokedex.Label"
        parent="Pokedex.Base">
        <item name="android:textColor">@color/fire_red</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--Valores-->
    <style name="Pokedex.Value"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">26sp</item>
    </style>

    <!--Descripción-->
    <style name="Pokedex.Body"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!--Tipo-->
    <style name="Pokedex.Tipo"
        parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/black</item>
        <item name="chipBackgroundColor">#FFEB3B</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>